{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NEETstuff/Limited-Hype-Station/blob/main/schemas/ticket-envelope-v0.schema.json",
  "title": "ticket-envelope-v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "status", "created_at", "expires_at", "handoff"],
  "properties": {
    "id": {
      "type": "string"
    },
    "schema": {
      "const": "ticket-envelope-v0"
    },
    "status": {
      "type": "string",
      "enum": ["open", "redeemed", "expired", "rejected"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "handoff": {
      "$ref": "./handoff-v0.schema.json"
    },
    "reject_reason": {
      "type": "string"
    }
  }
}
