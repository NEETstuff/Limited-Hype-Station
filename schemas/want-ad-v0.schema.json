{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NEETstuff/Limited-Hype-Station/blob/main/schemas/want-ad-v0.schema.json",
  "title": "want-ad-v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "need", "offer", "contact", "created_at", "expires_at"],
  "properties": {
    "schema": {
      "const": "want-ad-v0"
    },
    "id": {
      "type": "string"
    },
    "need": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "offer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "contact": {
      "type": "string",
      "maxLength": 300,
      "description": "Public contact only: URL, handle, or mailbox. No secrets."
    },
    "constraints": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
